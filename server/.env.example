# Copy this file to .env and fill in the values. See root README.md for
# exactly where to get each one.

# --- core (required to boot the server/worker at all) ---
DATABASE_URL="postgresql://user:password@localhost:5432/autoposter"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-a-long-random-string"
ENCRYPTION_KEY="replace-with-a-different-long-random-string"
PORT=4000
PUBLIC_SERVER_URL="http://localhost:4000"
CORS_ORIGIN="*"

# --- script generation (Anthropic) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- stock imagery (Pexels, free) ---
PEXELS_API_KEY=""

# --- narration (ElevenLabs) ---
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# --- YouTube upload (Google Cloud OAuth client, Web application type) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on the OAuth client, and must
# be reachable from wherever the user's phone opens it (so localhost only
# works for you, on your own machine, during development).
GOOGLE_REDIRECT_URI="http://localhost:4000/youtube/callback"
